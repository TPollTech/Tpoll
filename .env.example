# Copie para .env e ajuste antes de produção
TPOLL_ADMIN_PASSWORD=troque-uma-senha-forte
TPOLL_TOKEN_SECRET=troque-este-segredo-por-um-valor-longo-e-unico
PORT=5500

# URL base da aplicação (usada nos links de reset de senha)
APP_URL=http://localhost:5500
APP_NAME=TPoll Tech

# SMTP para e-mails transacionais (deixe em branco para usar Ethereal em dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="TPoll Tech" <noreply@tpolltech.com.br>
